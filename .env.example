# =============================================================================
# Smart Library & Study Center Management System - Environment Configuration
# =============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="Smart Library & Study Center Management System"
API_V1_STR="/api/v1"
DEBUG=True

# Database Configuration (PostgreSQL 15+)
# For Cloud PostgreSQL (Supabase, Neon, AWS RDS, etc.):
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres:your_password@your_cloud_host.supabase.co:5432/postgres?sslmode=require

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Security & Authentication
# Generate a secure 32+ character key using: openssl rand -hex 32
SECRET_KEY=change_this_to_a_super_secret_cryptographic_key_32_chars_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Initial Admin Seed Credentials
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@smartlibrary.com
INITIAL_ADMIN_PASSWORD=Admin@Library2026!
INITIAL_ADMIN_FULL_NAME="System Administrator"

# Business Policy Toggles
ALLOW_MULTI_SHIFT_PER_STUDENT=True
EXPIRING_SOON_THRESHOLD_DAYS=3
ATTENDANCE_GRACE_MINUTES=30
